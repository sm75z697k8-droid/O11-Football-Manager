{
  "name": "o11-football-manager",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "build": "npm run typecheck && vite build && node scripts/verify-build.mjs",
    "preview": "vite preview --host 0.0.0.0",
    "check": "npm run typecheck && npm run test && npm run build",
    "verify:build": "node scripts/verify-build.mjs",
    "benchmark:foundation": "vitest run tests/performance/foundation-baseline.test.ts",
    "benchmark:motion": "vitest run tests/performance/player-motion-baseline.test.ts",
    "benchmark:ball": "vitest run tests/performance/ball-physics-baseline.test.ts",
    "benchmark:contact": "vitest run tests/performance/player-ball-contact-baseline.test.ts",
    "benchmark:auto-contact": "vitest run tests/performance/automatic-contact-baseline.test.ts"
  },
  "dependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@types/node": "22.15.30",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.2.1",
    "typescript": "7.0.2",
    "vite": "8.3.7",
    "vitest": "5.1.0"
  }
}
